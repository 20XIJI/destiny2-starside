  {"anchor": "sec-6", "desc": "<p>击杀<span class=\"bar-orange\">橙血</span>、<span class=\"bar-yellow\">初级首领</span>、<span class=\"enemy\">勇士</span>或<span class=\"bar-yellow\">首领</span>时：<br> 提供 <span class=\"unsure\">?%</span> 的<span class=\"pickup\">手雷、近战与职业技能能量</span>。</p>", "hash": "4050859269", "icon": "armor-mods/icons/5fc434c761.webp", "kind": "救赎的边缘", "name": "高阶灭绝", "q": "高阶灭绝"},
